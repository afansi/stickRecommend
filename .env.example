# Database
DATABASE_URL=postgresql://user:password@db:5432/stock_app

# Security
SECRET_KEY=change_this_to_a_secure_random_string

# LLM Configuration
# Providers: ollama (default), openai, anthropic, gemini, deepseek
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# LLM_API_KEY=sk-your-api-key-here

# Example for OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=sk-proj-...

# Example for Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# LLM_API_KEY=sk-ant-...

# Scheduled Scanner Configuration
# Enable/disable automated market scanning
ENABLE_SCHEDULED_SCAN=true

# Cron schedule for market scans (minute hour day month day_of_week)
# Examples:
#   "0 6 * * 0"   = Every Sunday at 6:00 AM (default - weekly)
#   "0 6 * * 1-5" = Every weekday at 6:00 AM (daily, Mon-Fri)
#   "0 6 * * 1"   = Every Monday at 6:00 AM
SCAN_SCHEDULE=0 6 * * 0
